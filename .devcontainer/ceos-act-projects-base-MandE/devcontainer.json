{
  "name": "CAP - MandE - AVD GH Containerlab-Docker-Ouside-Docker",
  "image": "ghcr.io/wdion-arista/ceos-act-projects/base:avd-v6.1.0-v1.1.4",
  "runArgs": [
    "--network=host",
    "--pid=host",
    "--privileged",
    "--group-add=2020"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/avd/.ssh,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "type=bind,src=/run/docker/netns,dst=/run/docker/netns",
    "type=bind,src=/lib/modules,dst=/lib/modules"
  ],
  "postStartCommand": "sudo chmod 666 /var/run/docker.sock",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}/labs/MandE",
  "customizations": {
    "vscode": {
      "extensions": [
        "srl-labs.vscode-containerlab",
        "samuelcolvin.jinjahtml",
        "ms-vscode.makefile-tools",
        "redhat.ansible",
        "ms-azuretools.vscode-docker",
        "oderwat.indent-rainbow",
        "mechatroner.rainbow-csv",
        "redhat.vscode-yaml"
      ]
    }
  },
  "containerUser": "avd"
}

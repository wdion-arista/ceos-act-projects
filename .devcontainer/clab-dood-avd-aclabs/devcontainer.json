{
  "name": "AVD ACLABS Containerlab-Docker-Outside-Docker",
    // "image": "ghcr.io/${localEnv:GITHUB_REPOSITORY:aristanetworks/aclabs}/lab-base:${localEnv:GITHUB_CONATINER_IMAGE:python3.12-avd-v5.7.2-clab0.72.0-rev2.5.2}",
  "image": "ghcr.io/${localEnv:GITHUB_REPOSITORY:aristanetworks/aclabs}/lab-base:python3.12-avd-v5.7.2-clab0.73.0-rev2.100.4",
  // containerEnv set the variables applied to entire container
  "containerEnv": {
      "ARISTA_TOKEN": "${localEnv:ARTOKEN}",
      "CEOS_LAB_VERSION": "${localEnv:CEOS_IMAGE_VERSION:4.35.1F}",
      "CV_API_TOKEN": "${localEnv:CV_API_TOKEN}",
      "CONTAINERWSF": "${containerWorkspaceFolder}",
      "GITHUB_REPOSITORY": "${localEnv:GITHUB_REPOSITORY:aristanetworks/aclabs}",
      "PASSWORD": "${localEnv:CODER_PASSWORD}",
      "GIT_INIT": "false",
      "REMOTE_CONTAINERS": "true",
      "DEBUG_CODE": "1"
  },
  "secrets": {
    "ARTOKEN": {
        "description": "token to auto-download EOS images from arista.com."
        // "documentationUrl": "https://example.com/link/to/info"
    }
  },
  "runArgs": [
    "--network=host",
    "--pid=host",
    "--privileged",
    "--group-add=2020"
  ],
  "mounts": [
    //"source=/Users,target=/Users,type=bind",
    "source=/Users/${localEnv:USER}/.ssh,target=/home/avd/.ssh,type=bind",

    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "type=bind,src=/run/docker/netns,dst=/run/docker/netns",
    "type=bind,src=/lib/modules,dst=/lib/modules"
  ],
  // "postCreateCommand": "/bin/entrypoint",
  "postCreateCommand": "${localWorkspaceFolder}/scripts/aclab/entrypoint",
  "postStartCommand": "sudo chmod 666 /var/run/docker.sock",
  // "initializeCommand": "docker exec -u root ${devcontainerId} groupadd -g 2020 externalgroup || true",
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  // "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  // "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "srl-labs.vscode-containerlab",
        "samuelcolvin.jinjahtml",
        "ms-vscode.makefile-tools",
        "redhat.ansible",
        "ms-azuretools.vscode-docker",
        "oderwat.indent-rainbow",
        "mechatroner.rainbow-csv",
        "redhat.vscode-yaml"
      ]
    }
  },
  // "remoteUser": "root",        
  "containerUser": "avd"
}

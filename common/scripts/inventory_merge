#!/usr/bin/env python
# PYTHON_ARGCOMPLETE_OK

import argparse
import os
import yaml

def merge_yaml_files(base_path, target_file, output_file_name):
    """
    Finds and merges all target inventory files within subdirectories
    of a specified base path into a single YAML file.
    """
    merged_data = {}

    for dirpath, dirnames, filenames in os.walk(base_path):
        if target_file in filenames:
            file_path = os.path.join(dirpath, target_file)
            print(f"Reading file: {file_path}")

            try:
                with open(file_path, 'r') as f:
                    current_data = yaml.safe_load(f)
                    _deep_merge(merged_data, current_data)
            except Exception as e:
                print(f"Error processing {file_path}: {e}")

    output_dir = os.path.dirname(output_file_name)
    if output_dir and not os.path.exists(output_dir):
        os.makedirs(output_dir)
        print(f"Created directory: {output_dir}")

    try:
        with open(output_file_name, 'w') as f:
            yaml.dump(merged_data, f, default_flow_style=False)
        print(f"\nSuccessfully merged all files into {output_file_name}")
    except Exception as e:
        print(f"Error writing to {output_file_name}: {e}")

def _deep_merge(dict1, dict2):
    for key, value in dict2.items():
        if key in dict1 and isinstance(dict1[key], dict) and isinstance(value, dict):
            _deep_merge(dict1[key], value)
        else:
            dict1[key] = value

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Merge inventory YAML files across sites")
    parser.add_argument("--target-file", default="inventory-act.yml",
                        help="Inventory filename to search for (default: inventory-act.yml)")
    parser.add_argument("--output", default="wan/act_merged_inventory.yml",
                        help="Output merged file path (default: wan/act_merged_inventory.yml)")
    parser.add_argument("--start-dir", default="sites",
                        help="Root directory to search (default: sites)")
    args = parser.parse_args()

    merge_yaml_files(args.start_dir, args.target_file, args.output)

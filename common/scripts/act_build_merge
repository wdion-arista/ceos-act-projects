import os
import yaml

def merge_yaml_files(base_path, output_path):
    """
    Finds and merges all YAML files within 'act' subdirectories of 'sites/*'
    into a single YAML file, creating the output directory if it doesn't exist.

    Args:
        base_path (str): The root directory, e.g., 'sites'.
        output_path (str): The full path for the output file, e.g., 'wan/act_build.merged.yml'.
    """
    merged_data = {}
    
    # Use os.walk to traverse the directory tree from the base path
    for dirpath, dirnames, filenames in os.walk(base_path):
        # Check if the current directory is an 'act' folder
        if os.path.basename(dirpath) == 'act':
            for filename in filenames:
                # Process all files ending with .yml
                if filename.endswith('.yml'):
                    file_path = os.path.join(dirpath, filename)
                    print(f"Reading file: {file_path}")
                    
                    try:
                        with open(file_path, 'r') as f:
                            current_data = yaml.safe_load(f)
                            # Recursively merge the new data into our main dictionary
                            _deep_merge(merged_data, current_data)
                    except Exception as e:
                        print(f"Error processing {file_path}: {e}")

    # Ensure the output directory exists before writing the file
    output_dir = os.path.dirname(output_path)
    if output_dir and not os.path.exists(output_dir):
        os.makedirs(output_dir)
        print(f"Created directory: {output_dir}")

    # Write the final merged data to the output file
    try:
        with open(output_path, 'w') as f:
            yaml.dump(merged_data, f, default_flow_style=False)
        print(f"\nSuccessfully merged all files into {output_path}")
    except Exception as e:
        print(f"Error writing to {output_path}: {e}")

def _deep_merge(dict1, dict2):
    """
    Recursively merges the contents of dict2 into dict1.
    Handles nested dictionaries and appends to lists.
    """
    for key, value in dict2.items():
        if key in dict1 and isinstance(dict1[key], dict) and isinstance(value, dict):
            # If both are dictionaries, perform a recursive merge
            _deep_merge(dict1[key], value)
        elif key in dict1 and isinstance(dict1[key], list) and isinstance(value, list):
            # If both are lists, append the new items
            dict1[key].extend(value)
        else:
            # Otherwise, just assign the value from the second dictionary
            dict1[key] = value

if __name__ == "__main__":
    # The starting directory where the 'sites' folder is located
    start_directory = 'sites'
    # The desired full path for the final merged YAML file
    output_filepath = 'wan/act_build.merged.yml'

    merge_yaml_files(start_directory, output_filepath)

#!/usr/bin/env python

import argparse
import os
import yaml

def merge_yaml_files(base_path, subdir, output_path):
    """
    Finds and merges all YAML files within a named subdirectory of 'sites/*'
    into a single YAML file, creating the output directory if it doesn't exist.
    """
    merged_data = {}

    for dirpath, dirnames, filenames in os.walk(base_path):
        if os.path.basename(dirpath) == subdir:
            for filename in filenames:
                if filename.endswith('.yml'):
                    file_path = os.path.join(dirpath, filename)
                    print(f"Reading file: {file_path}")

                    try:
                        with open(file_path, 'r') as f:
                            current_data = yaml.safe_load(f)
                            _deep_merge(merged_data, current_data)
                    except Exception as e:
                        print(f"Error processing {file_path}: {e}")

    output_dir = os.path.dirname(output_path)
    if output_dir and not os.path.exists(output_dir):
        os.makedirs(output_dir)
        print(f"Created directory: {output_dir}")

    try:
        with open(output_path, 'w') as f:
            yaml.dump(merged_data, f, default_flow_style=False)
        print(f"\nSuccessfully merged all files into {output_path}")
    except Exception as e:
        print(f"Error writing to {output_path}: {e}")

def _deep_merge(dict1, dict2):
    for key, value in dict2.items():
        if key in dict1 and isinstance(dict1[key], dict) and isinstance(value, dict):
            _deep_merge(dict1[key], value)
        elif key in dict1 and isinstance(dict1[key], list) and isinstance(value, list):
            dict1[key].extend(value)
        else:
            dict1[key] = value

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Merge build YAML files across sites")
    parser.add_argument("--subdir", default="act",
                        help="Subdirectory name to search for under each site (default: act)")
    parser.add_argument("--output", default="wan/act_build.merged.yml",
                        help="Output merged file path (default: wan/act_build.merged.yml)")
    parser.add_argument("--start-dir", default="sites",
                        help="Root directory to search (default: sites)")
    args = parser.parse_args()

    merge_yaml_files(args.start_dir, args.subdir, args.output)

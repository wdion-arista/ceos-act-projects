def main():
    parser = argparse.ArgumentParser(description="A script to upload the support bundle to Egnyte")

    # Positional arguments
    parser.add_argument("--filename", type=str, help="Support bundle filename")
    parser.add_argument("--token", type=str, help="Bearer token for upload")
    parser.add_argument("--folder", type=str, help="Folder location on Egnyte")
    
    # Optional arguments
    parser.add_argument("--verbose", action="store_true", help="Enable verbose output.")
    args = parser.parse_args()
    argcomplete.autocomplete(parser)

    if args.verbose:
        print(f"Running in verbose mode.")
        print(f"Inventory file: {args.filename}")
        print(f"Fabric Name: {args.token}")
        print(f"Inventory Type: {args.folder}")
    if args.filename is None:
        print("No file Specified")
        exit()

    if not os.path.exists(args.filename):
        sys.exit(f"Error: Missing {args.filename} file. Please create one.")

    sb_directory, sb_filename = os.path.split(f'{args.filename}')
    if sb_directory == "":
        print("empty dir")
        sb_directory = "."    
    
    SOURCE_SB_FILENAME = f'{sb_directory}/{sb_filename}'

    upload_file_egnyte(SOURCE_SB_FILENAME, args.token, args.folder)

    print("\n--- Script finished ---")
    print("It has been uploaded")

if __name__ == "__main__":
    main()
def create_upload_token(secret_key, validity_days=3):
    """
    Generates a JWT bearer token for file uploads.

    Args:
        secret_key (str): The secret key to sign the token. Must be kept private
                          and be the same as the key used by the verifier.
        validity_days (int): The number of days the token will be valid for.

    Returns:
        str: The encoded JWT token.
    """
    try:
        # 1. Set the expiration time for the token
        expiration_time = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=validity_days)

        # 2. Create the payload for the token
        #    'exp': (Expiration Time) is a registered claim that is checked automatically.
        #    'iat': (Issued At) is the time the token was generated.
        #    'scope': A custom claim to define the token's permissions. The server
        #             will check this to grant access to specific actions.
        payload = {
            'exp': expiration_time,
            'iat': datetime.datetime.now(datetime.timezone.utc),
            'scope': 'file_upload' 
        }

        # 3. Encode the token with the secret key using the HS256 algorithm
        encoded_token = jwt.encode(
            payload,
            secret_key,
            algorithm="HS256"
        )

        return encoded_token

    except Exception as e:
        print(f"An error occurred while generating the token: {e}")
        return None

def get_user_info(token,url):
    """
    Fetches user information from the Egnyte API.

    Args:
        token (str): The bearer token for authentication.

    Returns:
        dict: A dictionary containing the user information, or None if an error occurs.
    """
    # The API endpoint URL
    api_url = f"{url}"

    # Set up the headers, including the Authorization header with the bearer token
    headers = {
        "Authorization": f"Bearer {token}"
    }

    print(f"Sending request to: {api_url}")
    print(f"Using headers: {headers}")

    try:
        # Make the GET request to the API
        response = requests.get(api_url)# , headers=headers)

        # This will raise an exception for HTTP errors (like 401 Unauthorized or 404 Not Found)
        response.raise_for_status()

        # If the request was successful, parse the JSON response
        user_data = response.json()
        return user_data

    except requests.exceptions.HTTPError as http_err:
        print(f"❌ HTTP error occurred: {http_err}")
        print(f"Response Body: {response.text}")
    except requests.exceptions.RequestException as req_err:
        print(f"❌ A request error occurred: {req_err}")
    except json.JSONDecodeError:
        print("❌ Failed to decode JSON from the response.")
        print(f"Response Body: {response.text}")
    
    return None



